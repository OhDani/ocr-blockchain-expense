generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  role          Role      @default(EMPLOYEE)
  
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  
  walletAddress String?   // Legacy
  avatarUrl     String?
  failedAttempts Int      @default(0)
  isLocked      Boolean   @default(false)
  departmentSelfSelected Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  wallet        Wallet?
  trips         Trip[]
  expenses      Expense[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model Trip {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  destination  String
  workLocation String?
  purpose      String?
  startDate    DateTime
  endDate      DateTime
  budget       Float
  status       TripStatus @default(PLANNED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  expenses   Expense[]
  activities TripActivity[]
}

enum TripStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

model TripActivity {
  id            String   @id @default(uuid())
  tripId        String
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date          DateTime
  time          String?
  title         String
  description   String?
  location      String?
  type          String   @default("other")
  completed     Boolean  @default(false)
  estimatedCost Float?
  createdAt     DateTime @default(now())
}

model Image {
  id        String   @id @default(uuid())
  fileName  String
  mimeType  String
  size      Int
  data      String   @db.Text
  createdAt DateTime @default(now())

  expense   Expense?
}

model Expense {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  tripId      String?
  trip        Trip?         @relation(fields: [tripId], references: [id])

  amount      Float
  invoiceType String?
  categoryId  String?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  invoiceHash String?
  status      ExpenseStatus @default(PENDING)
  userNote    String?

  imageId     String?       @unique
  image       Image?        @relation(fields: [imageId], references: [id])

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ocrResult      OcrResult?
  policyCheck    PolicyCheck?
  fraudAnalysis  FraudAnalysis?
  blockchainTx   BlockchainTx?
  reviews        ExpenseReview[]
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

model OcrResult {
  id             String   @id @default(uuid())
  expenseId      String   @unique
  expense        Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  rawText        String?  @db.Text
  parsedData     Json?
  processingTime Float?
  warnings       Json?
  createdAt      DateTime @default(now())
}

model PolicyCheck {
  id           String   @id @default(uuid())
  expenseId    String   @unique
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  status       String?
  checks       Json?
  details      Json?
  message      String?
  createdAt    DateTime @default(now())
}

model FraudAnalysis {
  id           String   @id @default(uuid())
  expenseId    String   @unique
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  fraudScore   Float    @default(0)
  fraudFlags   Json?
  createdAt    DateTime @default(now())
}

model BlockchainTx {
  id            String   @id @default(uuid())
  expenseId     String   @unique
  expense       Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  txHash        String?
  blockchainId  Int?
  gasUsed       String?
  status        String   @default("PENDING")
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ExpenseReview {
  id         String   @id @default(uuid())
  expenseId  String
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  action     String
  reviewerId String?
  reason     String?
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  expenseId String?
  createdAt DateTime @default(now())
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

model PolicyLimit {
  id                String   @id @default(uuid())
  role              Role     @unique
  dailyLimit        Float
  perInvoiceLimit   Float?
  totalPerTripLimit Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ExpenseCategory {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  defaultLimit Float?
  requireTaxId Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expenses     Expense[]
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address       String   @unique
  balance       Float    @default(0)
  status        String   @default("ACTIVE")
  lastUpdated   DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
}
