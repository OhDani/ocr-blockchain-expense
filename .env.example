# ═══════════════════════════════════════
# FlexiTrip — Environment Variables
# Copy file này thành .env và điền giá trị
# ═══════════════════════════════════════

# ── Database ──
DATABASE_URL="postgresql://user:password@localhost:5432/flexitrip?schema=public"

# ── JWT ──
JWT_SECRET="your_jwt_secret_here"

# ── AI / Gemini ──
GEMINI_API_KEY="your_gemini_api_key_here"

# ── Blockchain (Sepolia Testnet) ──
# Private key của ví deployer (có SepoliaETH)
ADMIN_PRIVATE_KEY="your_private_key_here"
BLOCKCHAIN_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# Contract addresses (tự động ghi sau khi deploy)
VVND_CONTRACT_ADDRESS=""
EXPENSE_MANAGER_ADDRESS=""

# ── Server ──
PORT=3000
CLIENT_URL="http://localhost:5173"
