# ═══════════════════════════════════════
# FlexiTrip — Environment Variables
# Copy file này thành .env và điền giá trị
# ═══════════════════════════════════════

# ── Database ──
DATABASE_URL="postgresql://user:password@localhost:5432/flexitrip?schema=public"

# ── JWT ──
JWT_SECRET="your_jwt_secret_here"

# ── AI / Gemini ──
GEMINI_API_KEY="your_gemini_api_key_here"

# ── Blockchain (Hardhat localhost) ──
# Hardhat Account #0 private key (mặc định, KHÔNG dùng cho production)
ADMIN_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Contract addresses (tự động ghi sau khi deploy)
VVND_CONTRACT_ADDRESS=""
EXPENSE_MANAGER_ADDRESS=""

# ── Server ──
PORT=3000
CLIENT_URL="http://localhost:5173"
